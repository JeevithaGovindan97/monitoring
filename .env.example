# Copy to .env (or paste into Dokploy → Environment). NEVER commit real values.
# ---- required ----
POSTGRES_PASSWORD=change-me-to-a-long-random-string
APP_BASE_URL=https://monitor.example.com

# ---- database (defaults shown) ----
POSTGRES_USER=monitor
POSTGRES_DB=monitor

# ---- e-mail alerts (SMTP). Without these, in-app alerts still work; e-mails are never faked as sent ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Website Monitoring <alerts@example.com>"
ALERT_RECIPIENTS=ops@example.com

# ---- Google (optional). Paste the service-account key JSON on ONE line, or mount a file and use GOOGLE_SERVICE_ACCOUNT_FILE ----
GOOGLE_SERVICE_ACCOUNT_JSON=
PAGESPEED_API_KEY=

# ---- monitoring policy ----
# false = block private/loopback/metadata targets (recommended). true only if you intentionally monitor internal hosts.
ALLOW_PRIVATE_TARGETS=false
CHECK_CONCURRENCY=10
# Dokploy (Traefik) + the bundled nginx = 2 proxy hops
TRUST_PROXY=2
LOG_LEVEL=info

# ---- backups (nightly pg_dump into the `backups` volume) ----
BACKUP_ENABLED=true
BACKUP_HOUR_UTC=2
BACKUP_RETENTION_DAYS=14
# Strongly recommended: AES-256 passphrase (store it in your password manager — backups are unrecoverable without it)
BACKUP_ENCRYPTION_PASSPHRASE=
# Optional off-server copy, e.g.  rclone copy "$BACKUP_FILE" remote:igo-monitor-backups/
BACKUP_UPLOAD_COMMAND=
